# Prisma — conexão direta ao Postgres do projeto Supabase (ou de um Postgres
# self-hosted). Nunca exposta ao navegador — só código server-only a lê.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/controle_acesso_garagem"

# Supabase — usado apenas para autenticação (login/logout/sessão). O acesso
# aos dados do cadastro passa por DATABASE_URL/Prisma, não pelo client
# Supabase (ver lib/db/prisma.ts).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
