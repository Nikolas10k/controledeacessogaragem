// Modelo de dados do cadastro — fonte da verdade do sistema.
//
// Escopo: cadastro (pessoas, empresas, vagas, veículos, subsolos, leitores),
// consentimento LGPD que alimenta a camada de tradução
// (lib/idface/translation.ts) e o registro manual de ocorrência da portaria
// que alimenta o módulo de diagnóstico (lib/diagnostico/ocorrencia-manual.ts).
// Fila de sincronização (fica em memória no agente por ora, ver
// lib/idface-client/queue.ts), logs de acesso consolidados e trilha de
// auditoria com encadeamento de hash são entregáveis futuros e não estão
// modelados aqui ainda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoVinculo {
  condomino
  funcionario
  prestador_fixo
  visitante_temporario
}

enum StatusPessoa {
  ativo
  bloqueado
  inativo
}

enum CancelaId {
  A
  B
}

enum PapelLeitor {
  entrada
  saida
}

enum TipoOcorrenciaManual {
  nao_abriu
  nao_desceu
  desceu_sobre_veiculo
  abertura_espontanea
}

/// Espelha EventoAcesso["tipo"] em lib/diagnostico/types.ts.
enum TipoEventoAcesso {
  autorizado
  efetivado
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  sala      String
  pessoas   Pessoa[]
  vagas     Vaga[]
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Subsolo {
  id        String   @id @default(uuid())
  /// "1", "2", "3"
  codigo    String   @unique
  nome      String
  /// Cancela que atende este subsolo — dado de configuração.
  cancelaId CancelaId
  vagas     Vaga[]
  pessoas   PessoaSubsolo[]
}

model Pessoa {
  id          String       @id @default(uuid())
  nome        String
  cpf         String       @unique
  telefone    String?
  email       String?
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  empresaId   String
  tipoVinculo TipoVinculo
  status      StatusPessoa @default(ativo)
  validadeInicio DateTime
  /// Nulo = vínculo por prazo indeterminado (condômino, funcionário fixo).
  validadeFim    DateTime?

  subsolosAutorizados PessoaSubsolo[]
  veiculos            Veiculo[]
  vaga                Vaga?
  consentimentos      ConsentimentoLGPD[]
  logsAcesso          LogAcesso[]

  /// Cache do consentimento vigente — a fonte da verdade é ConsentimentoLGPD;
  /// este campo evita uma consulta extra na camada de tradução.
  consentimentoBiometriaAceito Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([empresaId])
}

/// Um por subsolo autorizado — política: pessoa pode ter direito a mais de
/// um subsolo, e a camada de tradução concede a união das cancelas
/// correspondentes (ver lib/idface/routing.ts).
model PessoaSubsolo {
  pessoa    Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  pessoaId  String
  subsolo   Subsolo @relation(fields: [subsoloId], references: [id])
  subsoloId String

  @@id([pessoaId, subsoloId])
}

model Veiculo {
  id       String  @id @default(uuid())
  pessoa   Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  pessoaId String
  placa    String  @unique
  modelo   String?
  cor      String?

  @@index([pessoaId])
}

model Vaga {
  id        String   @id @default(uuid())
  numero    String
  subsolo   Subsolo  @relation(fields: [subsoloId], references: [id])
  subsoloId String
  empresa   Empresa? @relation(fields: [empresaId], references: [id])
  empresaId String?
  pessoa    Pessoa?  @relation(fields: [pessoaId], references: [id])
  pessoaId  String?  @unique

  @@unique([subsoloId, numero])
}

/// Registro versionado do consentimento LGPD para uso de biometria —
/// data/hora e IP do aceite, conforme exigido pelo spec. A revogação é
/// modelada como um novo registro com aceito=false (histórico completo,
/// nunca sobrescrito).
model ConsentimentoLGPD {
  id        String   @id @default(uuid())
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  pessoaId  String
  versaoTermo String
  aceito    Boolean
  ip        String
  registradoEm DateTime @default(now())

  @@index([pessoaId])
}

model Leitor {
  id              String      @id @default(uuid())
  nome            String
  papel           PapelLeitor
  ipAddress       String      @unique
  firmwareVersion String?

  online          Boolean   @default(false)
  ultimoSyncEm    DateTime?

  logs         LogAcesso[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Log de acesso consolidado — o que lib/idface-client/log-collector.ts
/// coleta do dispositivo (id > cursor, por leitor) e a aplicação persiste
/// aqui. Formato próximo de EventoAcesso (lib/diagnostico/types.ts) para
/// que a conversão na leitura seja direta; pessoaId fica nulo quando o log
/// não pôde ser correlacionado a uma pessoa cadastrada.
model LogAcesso {
  id                  String      @id @default(uuid())
  leitor              Leitor      @relation(fields: [leitorId], references: [id])
  leitorId            String
  /// Id do log no próprio dispositivo — usado pelo cursor de coleta incremental.
  idNoDispositivo     Int
  pessoa              Pessoa?     @relation(fields: [pessoaId], references: [id])
  pessoaId            String?
  cancelaId           CancelaId?
  papelLeitor         PapelLeitor
  tipo                TipoEventoAcesso
  timestamp           DateTime
  criadoEm            DateTime    @default(now())

  @@unique([leitorId, idNoDispositivo])
  @@index([pessoaId, timestamp])
  @@index([leitorId, timestamp])
}

/// Registro manual de ocorrência feito pela portaria — fonte de verdade
/// sobre o comportamento físico da cancela, já que os logs do iDFace só
/// registram autorizações (ver lib/diagnostico/ocorrencia-manual.ts e
/// lib/diagnostico/relatorio-mensal.ts, que cruza este registro com os
/// indicadores inferidos dos logs).
model OcorrenciaManual {
  id        String               @id @default(uuid())
  cancelaId CancelaId
  tipo      TipoOcorrenciaManual
  placa     String?
  observacao String?
  anexoFotoUrl String?

  registradoPorUsuarioId String
  /// Automático — momento do registro, não editável.
  registradoEm DateTime @default(now())

  @@index([cancelaId, registradoEm])
}
